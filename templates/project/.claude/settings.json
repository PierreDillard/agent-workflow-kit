{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"${CLAUDE_PROJECT_DIR}/{{KIT_DIR}}/hooks/show-handoff.sh\"; [ ! -f \"$hook\" ] || bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
