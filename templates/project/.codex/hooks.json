{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel)/{{KIT_DIR}}/hooks/show-handoff.sh\"; [ ! -f \"$hook\" ] || bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
