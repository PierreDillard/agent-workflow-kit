{
  "schemaVersion": 1,
  "id": "tasks",
  "version": "1.2.0",
  "description": "Tasks workflow capabilities",
  "requires": {},
  "skills": [
    {
      "name": "ants",
      "source": "skills/ants",
      "global": true
    },
    {
      "name": "write-task",
      "source": "skills/write-task"
    }
  ],
  "files": [],
  "rules": [
    {
      "id": "main",
      "source": "rules/main.md",
      "point": "task-validation"
    }
  ],
  "hooks": [],
  "checks": [
    {
      "pattern": "{{TASKS_DIR}}/todo/*/README.md",
      "type": "file",
      "maxBytes": 8192,
      "level": "warn"
    },
    {
      "pattern": "{{TASKS_DIR}}/todo/*/README.md",
      "type": "index",
      "level": "warn"
    }
  ]
}
