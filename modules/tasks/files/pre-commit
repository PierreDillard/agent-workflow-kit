#!/bin/sh
set -eu

is_protected_ref() {
    case "$1" in
        refs/heads/main|refs/heads/master) return 0 ;;
        *) return 1 ;;
    esac
}

if [ "$#" -gt 0 ]; then
    if [ "$1" != task-start ] || [ "$#" -lt 2 ] || [ "$#" -gt 3 ] || [ -z "$2" ]; then
        echo 'Usage: pre-commit task-start <task-slug> [feature-branch-prefix]' >&2
        exit 2
    fi
    proposed_branch="${3-codex/}$2"
    if ! git check-ref-format "refs/heads/$proposed_branch" || is_protected_ref "refs/heads/$proposed_branch"; then
        printf 'Invalid dedicated branch: %s\n' "$proposed_branch" >&2
        exit 2
    fi
fi

if current_ref=$(git symbolic-ref --quiet HEAD); then
    :
else
    branch_status=$?
    if [ "$#" -eq 0 ] && [ "$branch_status" -eq 1 ]; then
        exit 0
    fi
    echo 'Cannot determine the current Git branch. Switch to a named branch first.' >&2
    exit 1
fi

if is_protected_ref "$current_ref"; then
    protected_branch="${current_ref#refs/heads/}"
    if [ "$#" -eq 0 ]; then
        printf 'Commit blocked on %s. Commit from a dedicated branch.\n' "$protected_branch" >&2
    else
        printf 'ANTS task start or resume blocked on %s. Use the dedicated branch %s.\n' "$protected_branch" "$proposed_branch" >&2
    fi
    exit 1
fi
