{
  "schemaVersion": 1,
  "id": "bugs",
  "version": "1.2.0",
  "description": "Bugs workflow capabilities",
  "requires": {},
  "skills": [
    {
      "name": "bug-triage",
      "source": "skills/bug-triage"
    },
    {
      "name": "bug-fix-trace",
      "source": "skills/bug-fix-trace"
    }
  ],
  "files": [
    {
      "source": "files/README.md",
      "target": "{{TASKS_DIR}}/bugs/README.md",
      "editable": true
    }
  ],
  "rules": [
    {
      "id": "main",
      "source": "rules/main.md",
      "point": "task-validation"
    }
  ],
  "hooks": [],
  "checks": [
    {
      "path": "{{TASKS_DIR}}/bugs/README.md",
      "type": "file",
      "maxBytes": 8192,
      "level": "warn"
    },
    {
      "pattern": "{{TASKS_DIR}}/bugs/*.md",
      "type": "file",
      "maxBytes": 16384,
      "level": "warn"
    },
    {
      "path": "{{TASKS_DIR}}/bugs/README.md",
      "type": "index",
      "level": "warn"
    }
  ]
}
