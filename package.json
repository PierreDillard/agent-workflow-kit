{
  "name": "ants-kit",
  "version": "0.3.0",
  "description": "Modular task, memory and quality workflow for Claude Code, Codex and Copilot, installed into a single project directory.",
  "license": "MIT",
  "author": "Pierre Dillard",
  "homepage": "https://github.com/PierreDillard/agent-workflow-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreDillard/agent-workflow-kit.git"
  },
  "bugs": "https://github.com/PierreDillard/agent-workflow-kit/issues",
  "keywords": ["claude-code", "codex", "copilot", "agents", "skills", "workflow"],
  "bin": {
